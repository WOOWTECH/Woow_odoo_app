+                elif args == ('shell', 'service', 'check', 'phone'):out = 'Service phone: found'
+                elif args == ('shell', 'id', '-u'):out = '0'
+                elif args[:5] == ('shell', 'cmd', 'package', 'list', 'packages'):out = 'package:'+args[-1]+' uid:10213'
