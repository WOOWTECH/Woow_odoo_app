+"""Offline fake-clock coverage; subprocess, sockets and signals are never real."""
+import inspect
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+import connectivity
+import installed_artifacts
+import launcher
+import ui_driver
+
+HISTORY = Path('/Users/elmolin/WOOW-mobile-app-analysis/research/apporo-odoo/simulator-validation/android')
+
+
+def saved_connectivity(round_name):
+    return next(json.loads(line) for line in (HISTORY/round_name/'commands.jsonl').read_text().splitlines()
+                if json.loads(line).get('command', [])[-2:] == ['dumpsys', 'connectivity'])
+
+
+class ConnectivityTests(unittest.TestCase):
+    def setUp(self):
+        self.full = saved_connectivity('round5-installed-pull')['stdout']
+        self.clock = [100.0]
+        self.p = launcher.Probe()
+        self.p.work_deadline = 360
+        self.p.total_deadline = 400
+        self.p.record = Mock()
+        self.calls = []
+        for target in ('launcher.subprocess.Popen', 'launcher.os.kill', 'launcher.os.killpg', 'launcher.socket.socket'):
+            guard = patch(target, side_effect=AssertionError('No real runtime operation'))
+            guard.start(); self.addCleanup(guard.stop)
+        guard = patch.object(launcher, 'port_open', return_value=True)
+        guard.start(); self.addCleanup(guard.stop)
+        guard = patch.object(launcher.time, 'monotonic', side_effect=lambda:self.clock[0])
+        guard.start(); self.addCleanup(guard.stop)
+
+    def observe(self, duration=6, output=None, exit_code=0, deadline=None):
+        if deadline is not None:self.p.work_deadline = deadline
+        output = self.full if output is None else output
+        def command(args, **kwargs):
+            self.calls.append((args, kwargs))
+            budget = kwargs['timeout']
+            self.clock[0] += min(duration, budget)
+            if duration > budget:
+                raise subprocess.TimeoutExpired(args, budget, output=output.encode())
+            return subprocess.CompletedProcess(args, exit_code, output, '')
+        with patch.object(launcher.subprocess, 'run', side_effect=command):
+            return connectivity.verify_no_default_network(self.p, clock=lambda:self.clock[0])
+
+    def test_full_dump_above_four_under_twenty_succeeds_once(self):
+        result = self.observe(duration=12)
+        self.assertEqual(result['seconds'], 12)
+        self.assertEqual(len(self.calls), 1)
+        self.assertEqual(self.calls[0][0], self.p.adb_command+['shell', 'dumpsys', 'connectivity'])
+        self.assertEqual(self.calls[0][1]['timeout'], 20)
+        self.assertEqual((self.p.work_deadline, self.p.total_deadline), (360, 400))
+
+    def test_timeout_with_none_even_full_output_is_rejected_without_retry(self):
+        with self.assertRaises(RuntimeError):self.observe(duration=21)
+        self.assertEqual(len(self.calls), 1)
+        receipt = self.p.record.call_args.args[0]
+        self.assertTrue(receipt['timeout']); self.assertIsNone(receipt['exit'])
+        self.assertIn('Active default network: none', receipt['stdout'])
+
+    def test_round6_command58_partial_timeout_receipt_is_never_pass(self):
+        receipt = saved_connectivity('round6-system-ui-wait')
+        self.assertEqual(receipt['seconds'], 4.01)
+        self.assertTrue(receipt['timeout']); self.assertIsNone(receipt['exit'])
+        with self.assertRaises(RuntimeError):connectivity.require_complete_no_default_network(receipt)
+        # Even a falsely labelled exit0 cannot turn this truncated body into PASS.
+        with self.assertRaises(ValueError):
+            connectivity.require_complete_no_default_network(dict(receipt, exit=0, timeout=False, stderr=''))
+
+    def test_nonzero_with_none_rejected(self):
+        with self.assertRaises(RuntimeError):self.observe(exit_code=1)
+        self.assertEqual(len(self.calls), 1)
+
+    def test_partial_and_truncated_output_rejected_even_exit_zero(self):
+        for output in ('Active default network: none', self.full[:-1],
+                       self.full[:self.full.index('Network Offers:')],
+                       self.full.replace('Network Offers:', '[output truncated]'),
+                       self.full.replace('Permission Monitor:', '')):
+            with self.subTest(output_length=len(output)), self.assertRaises(ValueError):
+                self.observe(duration=1, output=output)
+        self.assertEqual(len(self.calls), 5)
+
+    def test_unknown_non_none_substring_and_ambiguous_state_rejected(self):
+        for state in ('', 'Active default network: unknown', 'Active default network: 100',
+                      'Active default network: none (stale)', ' Active default network: none',
+                      'Active default network: none\nActive default network: none',
+                      'Active default network: none\nActive default network: 100',
+                      'Active default network: none\nActive Default Network: unknown'):
+            with self.subTest(state=state), self.assertRaises(ValueError):
+                self.observe(duration=1, output=self.full.replace('Active default network: none', state))
+        self.assertEqual(len(self.calls), 8)
+
+    def test_missing_timeout_truncation_stderr_and_diagnostic_markers_fail_closed(self):
+        base = dict(exit=0, timeout=False, stdout=self.full, stderr='')
+        for changes in ({'timeout':None}, {'timeout':True}, {'truncated':True}, {'stderr':'warning'},
+                        {'stdout':self.full+'\n*** SERVICE DUMP TIMEOUT ***'},
+                        {'stdout':self.full.replace('Network Offers:', 'Network Offers:\nDUMP TIMEOUT')},
+                        {'stdout':None}):
+            with self.subTest(changes=list(changes)), self.assertRaises((RuntimeError, ValueError)):
+                connectivity.require_complete_no_default_network(dict(base, **changes))
+
+    def test_short_remaining_budget_clamped_success_no_deadline_extension(self):
+        self.observe(duration=4.5, deadline=106)
+        self.assertEqual(self.calls[0][1]['timeout'], 6)
+        self.assertEqual(self.p.work_deadline, 106); self.assertEqual(self.p.total_deadline, 400)
+
+    def test_short_remaining_budget_timeout_stops_at_deadline(self):
+        with self.assertRaises(TimeoutError):self.observe(duration=9, deadline=103)
+        self.assertEqual(len(self.calls), 1); self.assertEqual(self.calls[0][1]['timeout'], 3)
+        self.assertEqual(self.clock[0], 103)
+
+    def test_exhausted_remaining_budget_does_not_start(self):
+        for deadline in (99, 100):
+            with self.subTest(deadline=deadline), self.assertRaises(TimeoutError):self.observe(deadline=deadline)
+        self.assertEqual(self.calls, [])
+
+    def test_result_at_phase_deadline_rejected_even_exit_zero(self):
+        with self.assertRaises(TimeoutError):self.observe(duration=2, deadline=102)
+        self.assertEqual(len(self.calls), 1)
+
+    def test_monitor_stop_prevents_query(self):
+        self.p.stop.set()
+        with self.assertRaises(RuntimeError):self.observe()
+        self.assertEqual(self.calls, [])
+
+    def test_other_commands_still_have_four_second_default(self):
+        def command(args, **kwargs):
+            self.assertEqual(kwargs['timeout'], 4)
+            return subprocess.CompletedProcess(args, 0, '1', '')
+        with patch.object(launcher.subprocess, 'run', side_effect=command) as run:
+            self.p.shell('getprop', 'sys.boot_completed')
+        run.assert_called_once()
+        self.assertEqual(inspect.signature(launcher.Probe.run).parameters['maximum'].default, 4)
+        self.assertEqual(inspect.signature(launcher.Probe.adb).parameters['maximum'].default, 4)
+
+    def test_cleanup_keeps_forty_second_reserve_and_finishes_receipt(self):
+        with self.assertRaises(RuntimeError):self.observe(duration=21)
+        with tempfile.TemporaryDirectory() as directory, patch.object(launcher, 'EVIDENCE', Path(directory)), patch.object(launcher, 'port_open', return_value=False):
+            self.p.cleanup()
+            self.assertEqual(self.p.total_deadline, self.clock[0]+40)
+            self.assertTrue(self.p.receipt['cleanupResolved'])
+            self.assertTrue((Path(directory)/'receipt.json').is_file())
+            self.assertEqual(self.p.work_deadline, 360)
+
+    def test_cleanup_does_not_extend_existing_total_deadline(self):
+        self.p.total_deadline = 112
+        with tempfile.TemporaryDirectory() as directory, patch.object(launcher, 'EVIDENCE', Path(directory)), patch.object(launcher, 'port_open', return_value=False):
+            self.p.cleanup()
+        self.assertEqual(self.p.total_deadline, 112)
