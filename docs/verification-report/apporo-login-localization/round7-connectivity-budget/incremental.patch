+                out = ''
+                if args == ('get-state',):out = 'device'
+                elif args == ('emu', 'avd', 'name'):out = 'Apporo_Odoo_UI_API36\nOK'
+                elif args == ('devices',):out = 'List of devices attached\nemulator-5580\tdevice'
