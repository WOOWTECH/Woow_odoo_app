+    def test_unrelated_tooling_and_timeouts_are_byte_identical_to_round6(self):
+        here = Path(__file__).parent
+        before = here.with_name('round6-system-ui-wait')
+        for name in ('installed_artifacts.py', 'root_transition.py', 'phone_ready.py', 'readiness.py', 'system_ui_wait.py'):
+            with self.subTest(name=name):self.assertEqual((here/name).read_bytes(), (before/name).read_bytes())
+        original = '    def cleanup(self):'+(before/'launcher.py').read_text().split('    def cleanup(self):')[1].split('    def execute(')[0]
+        self.assertEqual(inspect.getsource(launcher.Probe.cleanup).rstrip(), original.rstrip())
