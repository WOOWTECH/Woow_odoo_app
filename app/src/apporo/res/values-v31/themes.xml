<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash must not choose a legacy WOOW role or icon background. -->
    <style name="Theme.WoowTechOdoo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/woowtech_blue</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>
    </style>
</resources>
