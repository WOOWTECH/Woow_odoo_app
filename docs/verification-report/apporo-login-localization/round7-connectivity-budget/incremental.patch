+                elif args == ('shell', 'dumpsys', 'package', ui_driver.HELPER):out = 'versionCode=2004001 versionName=2.4.0'
+                elif args == ('shell', 'settings', 'get', 'secure', 'default_input_method'):
+                    out = ui_driver.IME if p.previous_ime else 'original.IME'
