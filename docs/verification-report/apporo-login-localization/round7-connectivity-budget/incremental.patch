+            p.listener_pid = Mock(return_value=1234)
+            child = popen.return_value; child.pid = 12345; child.poll.return_value = None
+            child.wait.side_effect = lambda **kwargs:setattr(child.poll, 'return_value', 0)
+            connectivity_calls = []
